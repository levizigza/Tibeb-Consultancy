# Local environment template for TIBEB Consultancy.
# Copy this file to .env.local only when a future task needs environment variables.
# Do not put secrets in this file.
#
# No external services are configured.

# Public site origin, including protocol, once a domain is approved.
# Example: https://example.com
# NEXT_PUBLIC_SITE_URL=

# Inquiry email. Leave all three unset until a privacy notice is approved.
# If any value is missing, the contact form checks the inquiry and does not contact the business.
# RESEND_API_KEY=
# INQUIRY_FROM_EMAIL=
# INQUIRY_TO_EMAIL=
